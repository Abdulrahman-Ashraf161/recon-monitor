# Copy to docker/.env and fill in REAL secrets. No working defaults on purpose.
POSTGRES_DB=recon
POSTGRES_USER=recon
POSTGRES_PASSWORD=CHANGE-ME-long-random-password
DJANGO_SECRET_KEY=CHANGE-ME-output-of-secrets-token-urlsafe-50
ALLOWED_HOSTS=app.example.com
DATABASE_URL=postgres://recon:CHANGE-ME@db:5432/recon
# Public origin(s) for CSRF (needed behind a TLS reverse proxy):
CSRF_TRUSTED_ORIGINS=https://app.example.com
